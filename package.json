{
  "name": "pdf-signal-check",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.js && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.js && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "samples": "node scripts/generate-samples.js",
    "calibration": "node scripts/generate-calibration.js && node scripts/generate-attachment-calibration.js",
    "story:audio": "node scripts/build-story-soundtrack.mjs",
    "story:script": "node scripts/export-story-script.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@undrr/undrr-mangrove": "2.0.0",
    "@xmldom/xmldom": "0.9.12",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
